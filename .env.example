# Server-only. Never prefix these values with VITE_ or commit real credentials.
WORKBENCH_ENABLE_GROK=0
XAI_API_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
WORKBENCH_ACCESS_TOKEN=
# Shared PostgreSQL; apply npm run db:migrate before enabling paid requests.
DATABASE_URL=
WORKBENCH_RATE_PER_MIN=10
WORKBENCH_DAILY_REQUEST_CAP=200
WORKBENCH_DAILY_TOKEN_CAP=500000
WORKBENCH_MAX_CONCURRENCY=2
# Optional lower cap, never larger than the documented model window.
WORKBENCH_GROK_CONTEXT_FLOOR=
